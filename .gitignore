.venv/
.env
.env.*
!.env.example
.local/
# Local-only learning notes; never publish or force-add these files.
/docs/learning/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/
.DS_Store
# Xcode and SwiftPM build products for the iOS adapter
src/frontend-app/**/.build/
src/frontend-app/**/DerivedData/
src/frontend-app/**/xcuserdata/
src/frontend-app/**/*.xcworkspace/xcshareddata/swiftpm/
# Dataset contents are versioned with DVC; Git keeps manifests, configs and .dvc pointers.
# (version-prefixed patterns: DVC's matcher would treat /data/raw/*/ as data/raw/ itself)
/data/raw/raw-v*/
/data/processed/canonical/canonical-v*/
/data/synthetic/synthetic-v*/

# Preserve ignored build artifacts from the earlier standalone layout.
.build/
DerivedData/
xcuserdata/

# Optional external cohort inputs are local to this portfolio.
/data/

# Legacy local Xcode workspace may be recreated by an open IDE; current client is in src/.
/ios/
