# Local development only. Compose uses these intentionally non-production credentials.
HEALTHOPS_DATABASE_URL=postgresql+psycopg://healthops:local-only-password@localhost:55432/healthops
HEALTHOPS_ENVIRONMENT=local

# Assistant (optional); disabled when the base URL is unset.
# Local Ollama example (native API, reasoning control verified):
# HEALTHOPS_ASSISTANT_MODEL_BASE_URL=http://127.0.0.1:11434
# HEALTHOPS_ASSISTANT_MODEL_BACKEND=ollama          # or openai_compatible (no thinking control)
# HEALTHOPS_ASSISTANT_MODEL_NAME=qwen3:8b
# HEALTHOPS_ASSISTANT_THINKING=false                # Ollama backend only; Qwen3 thinks by default
# HEALTHOPS_ASSISTANT_ALLOW_TODAY_OVERRIDE=true     # evaluation only
# The containerized API reaches a host Ollama at http://host.docker.internal:11434.
# HEALTHOPS_ASSISTANT_RATE_LIMIT_PER_MINUTE=10   # per authenticated user; 0 disables
