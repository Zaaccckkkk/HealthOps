# Local development only. Compose uses these intentionally non-production credentials.
HEALTHOPS_DATABASE_URL=postgresql+psycopg://healthops:local-only-password@localhost:55432/healthops
HEALTHOPS_ENVIRONMENT=local

# Assistant (optional); disabled when the base URL is unset.
# Local Ollama example (native API, reasoning control verified):
# HEALTHOPS_ASSISTANT_MODEL_BASE_URL=http://127.0.0.1:11434
# HEALTHOPS_ASSISTANT_MODEL_BACKEND=ollama          # or openai_compatible (no thinking control)
# HEALTHOPS_ASSISTANT_MODEL_NAME=qwen3:8b
# HEALTHOPS_ASSISTANT_THINKING=false                # Ollama backend only; Qwen3 thinks by default
# HEALTHOPS_ASSISTANT_ALLOW_TODAY_OVERRIDE=true     # evaluation only
# The containerized API reaches a host Ollama at http://host.docker.internal:11434.
# Compose passes ASSISTANT_MODEL_BASE_URL (default http://host.docker.internal:11434) to the api container.
# ASSISTANT_MODEL_BASE_URL=http://host.docker.internal:11434
# HEALTHOPS_ASSISTANT_RATE_LIMIT_PER_MINUTE=10   # per authenticated user; 0 disables
# Reference library (RAG): embeddings use the assistant's Ollama by default (nomic-embed-text).
# HEALTHOPS_KNOWLEDGE_EMBEDDING_BASE_URL=   # defaults to HEALTHOPS_ASSISTANT_MODEL_BASE_URL
# HEALTHOPS_KNOWLEDGE_EMBEDDING_MODEL=nomic-embed-text
# HEALTHOPS_KNOWLEDGE_TOP_K=3
# HEALTHOPS_KNOWLEDGE_MIN_SIMILARITY=0.55
# `make rag` (container) reaches the host Ollama here; the host scripts use the variable above.
# KNOWLEDGE_EMBEDDING_BASE_URL=http://host.docker.internal:11434
# Google Health connector (server-side OAuth); all four are required to enable it.
# HEALTHOPS_GOOGLE_OAUTH_CLIENT_ID=
# HEALTHOPS_GOOGLE_OAUTH_CLIENT_SECRET=
# HEALTHOPS_GOOGLE_OAUTH_REDIRECT_URI=https://<public host>/v1/connections/google-health/callback
# HEALTHOPS_CONNECTION_KEY=   # Fernet key; rotating it requires reconnecting providers

# Data pipeline (make run / docker compose --profile data). Bump a version for every new build;
# a finished version is never overwritten.
RAW_DATA_VERSION=raw-v1
CANONICAL_DATA_VERSION=canonical-v0.1
SYNTHETIC_DATA_VERSION=synthetic-v0.2
BIDSLEEP_INCLUDE_MOTION=false     # true adds ~28 GB of accelerometry to the raw version
# LLM for synthetic context events: Ollama on the host with qwen3:4b (ollama pull qwen3:4b).
# Unreachable or model missing -> seed event library (logged). Set to off to skip the LLM.
CONTEXT_LLM_BASE_URL=http://host.docker.internal:11434

# Model training (make train-smoke / make train, Vertex AI uses the same image).
# W&B: set the key to log online; leave it empty for offline runs under src/model-training/.local/wandb.
# WANDB_API_KEY=
# WANDB_PROJECT=healthops-m3
# WANDB_ENTITY=
# TRAIN_MODELS=lightgbm,transformer,diffusion
