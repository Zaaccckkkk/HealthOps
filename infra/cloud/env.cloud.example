# Copy to .env.cloud on the VM (ignored by Git and Docker). Never commit the filled file.
HEALTHOPS_PUBLIC_HOST=203.0.113.10.sslip.io
HEALTHOPS_DB_PASSWORD=change-me-on-the-vm
HEALTHOPS_RATE_LIMIT_PER_MINUTE=10
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_MODEL=qwen3:8b
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_KEEP_ALIVE=1h
# Google Health connector: Web application OAuth client of the same project; the redirect URI
# must match the client exactly. HEALTHOPS_CONNECTION_KEY is a Fernet key
# (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
HEALTHOPS_GOOGLE_OAUTH_CLIENT_ID=
HEALTHOPS_GOOGLE_OAUTH_CLIENT_SECRET=
HEALTHOPS_GOOGLE_OAUTH_REDIRECT_URI=https://203.0.113.10.sslip.io/v1/connections/google-health/callback
HEALTHOPS_CONNECTION_KEY=
