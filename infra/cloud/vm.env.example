# Copy to .local/cloud/vm.env (ignored by Git) and fill in your own project. Read by
# scripts/cloud/vm.sh. Values below are the configuration verified on 2026-10-03.
PROJECT=your-gcp-project-id
ZONE=us-east4-a
VM=healthops-gpu
MACHINE=g2-standard-4
DISK_GB=100
NETWORK=healthops-net
ADDRESS=healthops-ip
# Image family resolves to the newest image; IMAGE pins the exact image that was verified.
IMAGE_FAMILY=common-cu129-ubuntu-2204-nvidia-580
IMAGE=common-cu129-ubuntu-2204-nvidia-580-v20261001
MAX_RUN=2h
